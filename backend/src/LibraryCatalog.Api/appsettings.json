{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=librarycatalog;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "library-catalog",
    "Audience": "library-catalog",
    "SigningKey": "dev-only-signing-key-change-me-in-any-real-deployment",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
